{
  "name": "@vipgroup/converter",
  "version": "0.1.0",
  "private": true,
  "description": "PDF to flipbook converter (library + CLI).",
  "type": "module",
  "exports": {
    ".": {
      "@vipgroup/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "convert": "node dist/cli.js"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.1.1",
    "@vipgroup/shared": "workspace:*",
    "commander": "^15.1.0",
    "pdfjs-dist": "^6.5.438",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "pdf-lib": "^1.17.1"
  },
  "bin": {
    "vipgroup-convert": "./dist/cli.js"
  }
}
