# VipGroup App — environment variables
# Copy this file to `.env` and fill in the values. Never commit `.env`.
# Every new variable must be added here with a comment explaining it.

# Studio data folder: library.json (folders and books), flipbooks/ and uploads/.
# Optional: defaults to <repo root>/storage. Set it when the studio runs from another
# folder (e.g. started by pm2) or keeps its data on another disk.
# STORAGE_DIR=/absolute/path/to/storage

# Folder holding the converted books only (<dir>/<id>/manifest.json, …).
# Optional: defaults to <STORAGE_DIR>/flipbooks.
# FLIPBOOKS_DIR=/absolute/path/to/storage/flipbooks
