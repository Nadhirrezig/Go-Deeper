# VipGroup App — environment variables
# Copy this file to `.env` and fill in the values. Never commit `.env`.
# Every new variable must be added here with a comment explaining it.

# Studio data folder: library.json (folders and books), flipbooks/ and uploads/.
# Ignored with Docker (docker-compose.yml uses its volume at /data).
# Optional: defaults to <repo root>/storage. Set it when the studio runs from another
# folder (e.g. started by pm2) or keeps its data on another disk.
# STORAGE_DIR=/absolute/path/to/storage

# Folder holding the converted books only (<dir>/<id>/manifest.json, …).
# Optional: defaults to <STORAGE_DIR>/flipbooks.
# FLIPBOOKS_DIR=/absolute/path/to/storage/flipbooks

# Cloudflare R2: where the studio publishes books. Each site reads its own bucket:
# goexperience.travel → "goexperience", www.vipdestinations.fr → "vipdestinations".
# Use the studio's own API token: "Object Read & Write", limited to those two buckets
# (Cloudflare → R2 → Manage API tokens). Needed to publish; the rest of the studio works without.
# Real values live only in the office PC's .env, never in git or chat.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional: the GO Experience bucket. Defaults to goexperience.
# R2_BUCKET=goexperience
# Optional: the VIP Destinations bucket. Defaults to vipdestinations.
# R2_BUCKET_VIPDESTINATIONS=vipdestinations
# Optional: the S3 API address. Defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com.
# R2_ENDPOINT=

# Addresses of the sites, for the "Voir sur le site" links and the share links of published
# flipbooks. Optional: default to the production sites.
# GOEXPERIENCE_URL=https://goexperience.travel
# VIPDESTINATIONS_URL=https://www.vipdestinations.fr

# PostgreSQL: the studio's library (folders, books) when it runs with Docker Compose.
# Required by `docker compose up`: the password of the database user "vipgroup". Use letters
# and digits only. It is set when the database is first created; changing it here afterwards
# does not change it in the database.
POSTGRES_PASSWORD=
# Outside Docker (pnpm dev), the studio keeps its library in storage/library.json, unless these
# point at a PostgreSQL server (or DATABASE_URL=postgres://user:password@host:5432/db does).
# PGHOST=localhost
# PGPORT=5432
# PGUSER=vipgroup
# PGPASSWORD=
# PGDATABASE=vipgroup

# Name of the studio on the office network (HTTPS). Optional: defaults to studio.vipgroup.lan.
# The office router's DNS (or each PC's hosts file) must point it to the office PC's IP.
# The certificate authority is made for this one name: after changing it, the `ca` volume must
# be deleted and the certificate installed again on every PC (README, "HTTPS on the office network").
# STUDIO_HOST=studio.vipgroup.lan
